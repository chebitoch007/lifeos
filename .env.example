# =============================================================================
# LifeOS — Environment Variables
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lifeos

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Backend — FastAPI
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://lifeos:change-me@postgres:5432/lifeos
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Secret used for JWT signing — generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DEBUG=false

# ---------------------------------------------------------------------------
# Frontend — Next.js / Auth.js
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000

# Secret used by Auth.js — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-hex-32

# OAuth providers (add as needed in later phases)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
