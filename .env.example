# =============================================================================
# LifeOS — Environment Variables
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.
# See SECRETS.md for instructions on generating secure values.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=<generate: openssl rand -hex 16>
POSTGRES_DB=lifeos

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# Dev:  http://localhost:3000
# Prod: https://your-domain.com
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Backend — FastAPI
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://lifeos:<POSTGRES_PASSWORD>@postgres:5432/lifeos
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Secret used for JWT signing
# Generate with: openssl rand -hex 32
SECRET_KEY=<generate: openssl rand -hex 32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DEBUG=false

# ---------------------------------------------------------------------------
# Frontend — Next.js / Auth.js
# ---------------------------------------------------------------------------
# Development: http://localhost:8000
# Production:  https://your-domain.com or https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Development: http://localhost:3000
# Production:  https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Secret used by Auth.js
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=<generate: openssl rand -hex 32>

# ---------------------------------------------------------------------------
# OAuth providers (add as needed in future phases)
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
